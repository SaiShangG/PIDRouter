# Single source of network settings for development and production builds.
# Edit this file directly. Other env files, shell variables, and runtime config do not override it.

# Local frontend development server opened in the browser.
PID_FRONTEND_HOST=127.0.0.1
PID_FRONTEND_PORT=5173

# ProcessAssistant target used by the development proxy or direct browser requests.
# Set the browser-accessible backend IP/domain and port here before building.
# Builds embed this value; changing the deployed backend requires rebuilding.
VITE_PROCESS_ASSISTANT_API_URL=http://127.0.0.1:5153

# Keep true in local development to avoid browser CORS restrictions.
VITE_PROCESS_ASSISTANT_USE_PROXY=true

# Existing Project ID used as the parent of Procedure (frontend Process).
VITE_PROCESS_ASSISTANT_PROJECT_ID=1
