# Single source of network settings for development and production builds.
# Edit this file directly. Other env files, shell variables, and runtime config do not override it.

# Listen on all network interfaces for local and LAN access.
# Open localhost locally, or this computer's current IP from another device.
PID_FRONTEND_HOST=0.0.0.0
PID_FRONTEND_PORT=5173

# ProcessAssistant target used by the development proxy or direct browser requests.
# With frontend/backend on the same computer, "auto" uses the frontend hostname
# in the browser and 127.0.0.1 in the development proxy. No IP edits or rebuilds
# are needed when switching networks; open the frontend using its current IP.
# For a backend on another computer, set its explicit HTTP/HTTPS URL instead.
VITE_PROCESS_ASSISTANT_API_URL=http://auto:5153

# Keep true in local development to avoid browser CORS restrictions.
VITE_PROCESS_ASSISTANT_USE_PROXY=true

# Existing Project ID used as the parent of Procedure (frontend Process).
VITE_PROCESS_ASSISTANT_PROJECT_ID=1
